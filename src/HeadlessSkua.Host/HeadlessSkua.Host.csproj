<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HeadlessSkua</AssemblyName>
    <!-- Match the vendored VibeSkua core version so scripts see the correct client version. -->
    <InformationalVersion>2.1.5</InformationalVersion>
    <ApplicationIcon>../../HeadLessSkua.ico</ApplicationIcon>
    <RootNamespace>HeadlessSkua</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../HeadlessConsole.cs" Link="HeadlessConsole.cs" />
    <Content Include="../../panel/**/*" Link="panel/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../HeadlessSkua.Compatibility/HeadlessSkua.Compatibility.csproj" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Core/Skua.Core.csproj" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Plugin.ButlerV5/Skua.Plugin.ButlerV5.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>BundledPlugin</OutputItemType>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPanelAssetsToBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <PanelFiles Include="$(MSBuildProjectDirectory)\..\..\panel\**\*" />
    </ItemGroup>
    <MakeDir Directories="@(PanelFiles->'$(TargetDir)panel\%(RecursiveDir)')" />
    <Copy SourceFiles="@(PanelFiles)" DestinationFiles="@(PanelFiles->'$(TargetDir)panel\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPanelAssetsToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <PanelPublishFiles Include="$(MSBuildProjectDirectory)\..\..\panel\**\*" />
    </ItemGroup>
    <MakeDir Directories="@(PanelPublishFiles->'$(PublishDir)panel\%(RecursiveDir)')" />
    <Copy SourceFiles="@(PanelPublishFiles)" DestinationFiles="@(PanelPublishFiles->'$(PublishDir)panel\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)plugins" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\vendor\VibeSkua\Skua.Plugin.ButlerV5\bin\$(Configuration)\net10.0\ButlerV5.dll" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\..\..\vendor\VibeSkua\Skua.Plugin.ButlerV5\bin\$(Configuration)\net10.0\ButlerV5.dll')" />
  </Target>

  <Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\vendor\VibeSkua\Skua.Plugin.ButlerV5\bin\$(Configuration)\net10.0\ButlerV5.dll" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\..\..\vendor\VibeSkua\Skua.Plugin.ButlerV5\bin\$(Configuration)\net10.0\ButlerV5.dll')" />
  </Target>
</Project>
