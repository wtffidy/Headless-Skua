<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HeadlessSkua</AssemblyName>
    <ApplicationIcon>../../HeadLessSkua.ico</ApplicationIcon>
    <RootNamespace>HeadlessSkua</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../HeadlessConsole.cs" Link="HeadlessConsole.cs" />
    <Content Include="../../panel/**/*" Link="panel/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Core/Skua.Core.csproj" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Plugin.ButlerV5/Skua.Plugin.ButlerV5.csproj" />
  </ItemGroup>

  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)plugins" />
    <Copy SourceFiles="$(TargetDir)ButlerV5.dll" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="$(TargetDir)ButlerV5.dll" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRuffleRuntimeToBuildOutput" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\runtime\ruffle-host\index.html')">
    <ItemGroup>
      <RuffleRuntimeFiles Include="$(MSBuildProjectDirectory)\..\..\runtime\ruffle-host\**\*" />
    </ItemGroup>
    <MakeDir Directories="@(RuffleRuntimeFiles->'$(TargetDir)runtime\ruffle-host\%(RecursiveDir)')" />
    <Copy SourceFiles="@(RuffleRuntimeFiles)" DestinationFiles="@(RuffleRuntimeFiles->'$(TargetDir)runtime\ruffle-host\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
