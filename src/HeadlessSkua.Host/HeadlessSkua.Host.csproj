<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HeadlessSkua</AssemblyName>
    <RootNamespace>HeadlessSkua</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Core/Skua.Core.csproj" />
    <ProjectReference Include="../../vendor/VibeSkua/Skua.Plugin.ButlerV5/Skua.Plugin.ButlerV5.csproj" />
  </ItemGroup>
  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)plugins" />
    <Copy SourceFiles="$(TargetDir)ButlerV5.dll" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
